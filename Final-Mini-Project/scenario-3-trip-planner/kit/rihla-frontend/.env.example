# Copy to .env.local (git-ignored) and fill in. Vite reads it at start-up: restart `npm run dev` after a change.

# Live AI trip generation (off: the form explains that no trip was generated).
VITE_ENABLE_LIVE_AI=true

# Google sign-in through Firebase Authentication. Firebase console > Project settings > General > Your apps >
# Web app > SDK setup and configuration. These identify the project and are public by design (they grant
# nothing); the backend verifies every sign-in itself. Never put a service-account key here.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project
VITE_FIREBASE_APP_ID=
