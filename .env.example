# Agentic AI Bootcamp — environment template
# Copy this file to `.env` (which is git-ignored) and fill in your key.
# NEVER commit your real .env or paste keys into code.

# --- LLM access (OpenRouter — OpenAI-compatible gateway) ---
# Create a key at https://openrouter.ai/keys  (starts with sk-or-...)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Default class model (used across all modules). The "provider/" prefix is required.
#   - Raw openai SDK / langchain-openai:  openai/gpt-4o-mini
#   - CrewAI (LiteLLM) model string:      openrouter/openai/gpt-4o-mini
# MODEL=openai/gpt-4o-mini

# --- Optional: only needed for the Module 5 real search tool (else use the mock) ---
SEARCH_API_KEY=
